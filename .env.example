# Braindance admin-app / VPS environment.
# Copy to /srv/.env on the host, `chmod 600`, and fill in real values.
# Consumed two ways (see docker-compose.yml and deploy.sh):
#   - Compose ${VAR} interpolation, via ./deploy.sh (--env-file /srv/.env)
#   - Container runtime env, via each service's `env_file: /srv/.env`

# --- Public site config (Compose interpolation + Caddy {$DOMAIN}) ---
DOMAIN=example.com
API_IMAGE=ghcr.io/OWNER/REPO/api:latest

# --- Mobile API secrets (api container runtime) ---
GITHUB_REPO=OWNER/REPO
GITHUB_TOKEN=ghp_your_pat_here

# --- Task / calendar behaviour (api container runtime) ---
# LOAD-BEARING: TZ decides where the day boundary falls, and therefore what
# /todo calls Overdue, Today and Tomorrow. Unset, the container runs on UTC and
# rolls over mid-afternoon in the Americas — so "tomorrow" shows up as today.
# Set it to the timezone you actually live in.
TZ=America/Los_Angeles

# How long a timed atom (`@14:00` in the task text) lasts when it names only a
# start. Optional; 30 minutes if unset.
#TASK_DEFAULT_DURATION_MIN=30

# Where this viewer is reachable. Optional; when set, each event in the
# /todo.ics feed carries a URL back to the note the task lives in.
#PUBLIC_BASE_URL=http://100.x.y.z:3000

# Alerts in the /todo.ics feed. Both take a comma-separated list, so one task
# can nag more than once. Unset = silent.
#
# TIMED atoms (`@14:00` in the task text) alert this many minutes BEFORE they
# start:
#TODO_ICS_ALARM_MIN=60,15
#
# ALL-DAY atoms have no start time — they begin at midnight, so a
# minutes-before offset would fire the night before. These are times of day on
# the task's OWN day instead. Defaults to 09:00 when TODO_ICS_ALARM_MIN is set
# and this isn't.
#TODO_ICS_ALLDAY_ALARM_AT=09:00,18:00

# --- AI triage suggestions (api container runtime) ---
# OFF unless BOTH of the next two are set. With either missing the worker never
# starts, no client is constructed, and the app makes no outbound call at all —
# the review desk simply shows no suggestion. This is the off switch; it is not a
# soft one.
#AI_SUGGEST=1
#ANTHROPIC_API_KEY=sk-ant-...
#
# Which model classifies a capture. Defaults to claude-haiku-4-5 — a small,
# schema-constrained classification is what Haiku is for, at 1/5th Opus's price
# ($1/$5 per Mtok vs $5/$25). Overriding to a bigger model works, but note the
# request deliberately sends NO `effort` (Haiku 4.5 rejects it), so a pricier
# model here runs at its default effort and costs accordingly.
#AI_MODEL=claude-haiku-4-5
#
# How often the worker scans the inbox, in ms. Minimum 5000 (anything lower, or
# unparseable, falls back to 60000). It processes at most 3 notes per tick, so
# this is the knob for how fast a fresh capture gets its suggestion, not a cost
# multiplier — a note is asked about once and the answer is cached on disk.
#SUGGEST_INTERVAL_MS=60000
#
# Where those cached answers live. Defaults to /srv/braindance-suggestions, which
# docker-compose.yml backs with the named volume `braindance_suggestions` — they
# MUST agree, and both must stay outside the vault checkout. These files hold the
# "already asked" and "gave up" markers; lose them and the whole inbox is
# re-suggested at full price on the next boot. Must not be PROPOSALS_DIR: the
# suggestion store prunes its own directory, and the worker refuses to start if
# the two resolve to the same path.
#SUGGESTIONS_DIR=/srv/braindance-suggestions
