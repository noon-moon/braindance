# Working repos — cloned here locally, never tracked
repo/

# Ephemeral scratch — non-persisted things, never tracked. Lives inside the
# vault so Obsidian can see it; scoped to the _ephemeral/ subfolder so real
# vault notes stay tracked. (The explanatory README is the one tracked file.)
# This root rule also holds in a personal fork that un-ignores its vault notes.
ctx/vault/_ephemeral/*
!ctx/vault/_ephemeral/README.md

# Harness-generated sync targets (created by ctx/tools/sys/sync.sh)
.claude/*
.cursor/
# ...except the canonical guard hooks + their self-tests, which are real
# source-of-truth carried by the template (not sync-generated). Consumed by a
# fork's .claude/settings.json PreToolUse / SessionStart hooks.
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/block-loon-main-writes.py
!.claude/hooks/test_block_loon_main_writes.py
# active-instance model (docs/instances.md): shared registry lib, the C2
# cross-instance PreToolUse guard, the SessionStart context hook, + their tests.
!.claude/hooks/_bd_registry.py
!.claude/hooks/block-cross-instance-writes.py
!.claude/hooks/test_block_cross_instance_writes.py
!.claude/hooks/resolve-instance.py
!.claude/hooks/test_resolve_instance.py

# Node
node_modules/
api/dist/

# Host secrets — the real one lives at /srv/.env, never in the repo
.env

# OS
.DS_Store
Thumbs.db
