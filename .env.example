# Braindance admin-app / VPS environment.
# Copy to /srv/.env on the host, `chmod 600`, and fill in real values.
# Consumed two ways (see docker-compose.yml and deploy.sh):
#   - Compose ${VAR} interpolation, via ./deploy.sh (--env-file /srv/.env)
#   - Container runtime env, via each service's `env_file: /srv/.env`

# --- Public site config (Compose interpolation + Caddy {$DOMAIN}) ---
DOMAIN=example.com
API_IMAGE=ghcr.io/OWNER/REPO/api:latest

# --- Mobile API secrets (api container runtime) ---
GITHUB_REPO=OWNER/REPO
GITHUB_TOKEN=ghp_your_pat_here

# --- Task / calendar behaviour (api container runtime) ---
# LOAD-BEARING: TZ decides where the day boundary falls, and therefore what
# /todo calls Overdue, Today and Tomorrow. Unset, the container runs on UTC and
# rolls over mid-afternoon in the Americas — so "tomorrow" shows up as today.
# Set it to the timezone you actually live in.
TZ=America/Los_Angeles

# How long a timed atom (`@14:00` in the task text) lasts when it names only a
# start. Optional; 30 minutes if unset.
#TASK_DEFAULT_DURATION_MIN=30

# Where this viewer is reachable. Optional; when set, each event in the
# /todo.ics feed carries a URL back to the note the task lives in.
#PUBLIC_BASE_URL=http://100.x.y.z:3000

# Minutes before an event that a subscribed calendar should alert. Optional and
# unset by default — an alarm on every task turns a calendar into a nag.
#TODO_ICS_ALARM_MIN=15
