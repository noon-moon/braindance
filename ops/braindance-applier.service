# One applier pass (oneshot; driven by braindance-applier.timer).
# Classifies armed captures, acts on answered proposals, and pushes the result.
# See ops/README.md to install.
[Unit]
Description=Braindance applier pass (triage the vault)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# ← Set to your non-root deploy user (the one that owns the vault checkout).
User=deploy
# ANTHROPIC_API_KEY lives here. Optional (`-`) so a box without it fails loudly
# in the pass, and therefore in the vault, rather than refusing to start where
# only journalctl would ever say so.
EnvironmentFile=-/srv/.env
WorkingDirectory=/srv/vault
ExecStart=/srv/braindance/ops/applier.sh
